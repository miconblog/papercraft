# Supabase — 자체 웹 분석 (IDE-013)
#
# 이 파일은 커밋하고, 실제 값은 .env.local 에 넣는다(커밋 금지).
#
#   cp .env.example .env.local
#
# 이 Supabase 프로젝트는 다른 서비스와 함께 쓴다. 우리는 daddys_craft 스키마만
# 건드리고, public 과 다른 서비스의 스키마에는 절대 손대지 않는다.
#
# ⚠️  supabase db reset 은 절대 실행하지 않는다 — 다른 서비스 데이터가 날아간다.
#     supabase db push 도 쓰지 않는다 — 마이그레이션 이력의 주인이 저 쪽 저장소다.
#     스키마 변경은 npm run db:migrate 로 적용한다.
#
# 📋  선행 설정: 대시보드 > Settings > API > Exposed schemas 에 daddys_craft 를
#     추가해야 한다. supabase-js 는 PostgREST 를 거치고, PostgREST 는 이 목록에
#     있는 스키마만 본다 — 서비스 롤 키로도 우회되지 않는다.
#     기존 목록에 더하기만 하므로 다른 서비스에는 영향이 없다.

# ── 런타임 (supabase-js) ─────────────────────────────────────────────
# 대시보드 > Settings > API

# 프로젝트 URL — 예) https://abcdefghijklmno.supabase.co
# NEXT_PUBLIC_ 을 붙이지 않는다. 브라우저는 Supabase 에 직접 붙지 않는다.
SUPABASE_URL=

# 서비스 롤 키 — RLS 를 우회한다. 절대 클라이언트로 나가면 안 된다.
# 익명 키는 쓰지 않는다. 모든 접근이 서버 API 를 거친다.
SUPABASE_SERVICE_ROLE_KEY=

# ── 마이그레이션 · 트랜잭션 ──────────────────────────────────────────
# 대시보드 > Connect > Session pooler (5432 포트)
#
# 지금은 npm run db:migrate 만 쓴다. 나중에 여러 문장을 한 트랜잭션으로 묶어야
# 할 일이 생기면(PostgREST 로는 안 되는 것) 이 연결을 쓴다.
# 배포 환경에는 넣지 않는다 — 로컬·CI 전용이다.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── 분석 설정 ────────────────────────────────────────────────────────

# 방문자 식별 해시에 섞는 비밀값. 아무 긴 임의 문자열이면 된다.
#   openssl rand -hex 32
ANALYTICS_HASH_SALT=

# 수집 스위치. 비워 두거나 위 키가 없으면 수집을 끈다(로컬·CI 기본).
ANALYTICS_ENABLED=

# /admin/analytics 접근 비밀번호. 관리자가 1명뿐이라 이것 하나로 잠근다.
# 비워 두면 /admin/analytics 는 404 가 된다.
#   openssl rand -base64 24
ANALYTICS_ADMIN_PASSWORD=
